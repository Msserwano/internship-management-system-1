# Environment variables (example)
# Copy to .env and fill values as required for local development or CI

# Server
NODE_ENV=development
PORT=5000

# Database (preferred: set DATABASE_URL in production)
# Example: postgres://user:password@localhost:5432/kcca_ims
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kcca_ims
DB_MAX_CLIENTS=20

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (for production provide valid SMTP creds)
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025

# Frontend
FRONTEND_URL=http://localhost:5173
